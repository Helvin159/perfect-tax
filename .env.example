# Local PostgreSQL only. Do not reuse these values outside local development.
POSTGRES_DB=client_services_portal
POSTGRES_USER=client_services_portal
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://client_services_portal:local-development-only@localhost:5432/client_services_portal

# Replace this instruction with the output of: openssl rand -base64 48
PAYLOAD_SECRET=replace-with-output-of-openssl-rand-base64-48

# Canonical public origin. Paths, query strings, and fragments are not allowed.
SITE_URL=http://localhost:3000
