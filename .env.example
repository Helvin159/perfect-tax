# Local PostgreSQL only. Do not reuse these values outside local development.
POSTGRES_DB=client_services_portal
POSTGRES_USER=client_services_portal
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://client_services_portal:local-development-only@localhost:5432/client_services_portal

# Better Auth uses a separate PostgreSQL role. Agent 14 owns creation of the
# portal_auth schema, role defaults, reviewed SQL, and migration ledger.
PORTAL_AUTH_DATABASE_URL=postgresql://portal_auth:local-auth-only@localhost:5432/client_services_portal

# Replace this instruction with the output of: openssl rand -base64 48
PAYLOAD_SECRET=replace-with-output-of-openssl-rand-base64-48

# Generate a separate secret with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-base64-48

# Canonical public origin. Paths, query strings, and fragments are not allowed.
SITE_URL=http://localhost:3000

# Ethereal is a capture-only SMTP service for development and testing. Create a
# reusable account at https://ethereal.email and keep its credentials local.
EMAIL_NAME=Perfect Tax
EMAIL_ADDRESS=replace-with-ethereal-address
EMAIL_PASSWORD=replace-with-ethereal-password
